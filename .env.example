# 실제 키는 각자 .env 에. 이 파일에는 이름만.
LLM_PROVIDER=mock          # mock | vllm | claude | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VLLM_BASE_URL=http://10.1.2.22:8080/v1   # 게이트웨이(:8080) 경유. vLLM 직접은 :8000 (VPN 필요)
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
CLAUDE_MODEL=claude-opus-4-8
PROMOTE_BELOW=0.8          # 이보다 낮은 confidence 는 Claude 로 승격 (게이트웨이가 토큰 확률로 계산)
CONFIRM_SUBMIT=0           # 1 이면 최종 제출 직전에 사람 승인(데모의 [변경 확정] 장면). 캡차·본인인증·서버 거부는 값과 무관하게 항상 사람에게
